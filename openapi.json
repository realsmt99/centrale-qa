{
  "openapi": "3.0.3",
  "info": {
    "title": "Mini La Centrale API",
    "version": "0.1.0",
    "description": "Small fake car-marketplace backend used as a QA playground."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health check",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "versions": {
                      "type": "integer",
                      "description": "Rows in the reference catalogue"
                    },
                    "listings": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "status",
                    "versions",
                    "listings"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/feeds/import": {
      "post": {
        "summary": "Import a dealer's full stock (JSON or CSV)",
        "tags": [
          "feeds"
        ],
        "description": "The feed is the dealer's complete current stock. New cars are created, changed cars are updated, and active cars missing from the feed are marked sold.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "cars"
                ],
                "properties": {
                  "cars": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "externalRef",
                        "versionId",
                        "year",
                        "mileageKm",
                        "price"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "externalRef": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64,
                          "description": "The car's ID in the dealer's software"
                        },
                        "versionId": {
                          "type": "integer",
                          "minimum": 1,
                          "description": "ID from the reference catalogue"
                        },
                        "plate": {
                          "type": "string",
                          "pattern": "^[A-HJ-NP-TV-Z]{2}-[0-9]{3}-[A-HJ-NP-TV-Z]{2}$"
                        },
                        "year": {
                          "type": "integer",
                          "minimum": 1990
                        },
                        "mileageKm": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "price": {
                          "type": "integer",
                          "description": "Asking price in euros"
                        },
                        "color": {
                          "type": "string",
                          "maxLength": 30
                        }
                      }
                    },
                    "maxItems": 50000
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "in": "query",
            "name": "dealerId",
            "required": true
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "dealerId": {
                      "type": "string"
                    },
                    "received": {
                      "type": "integer"
                    },
                    "created": {
                      "type": "integer"
                    },
                    "updated": {
                      "type": "integer"
                    },
                    "unchanged": {
                      "type": "integer"
                    },
                    "markedSold": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "details": {}
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "details": {}
                  }
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "details": {}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/vehicles/{plate}": {
      "get": {
        "summary": "Identify the exact vehicle version from a French license plate",
        "tags": [
          "vehicles"
        ],
        "description": "Reads the registration data for the plate, then matches it to one version of the reference catalogue. Accepts AB-123-CD, AB123CD or ab 123 cd.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            },
            "in": "path",
            "name": "plate",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "plate": {
                      "type": "string",
                      "example": "AB-123-CD"
                    },
                    "firstRegistration": {
                      "type": "string",
                      "format": "date"
                    },
                    "versionId": {
                      "type": "integer"
                    },
                    "brand": {
                      "type": "string"
                    },
                    "model": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "fuel": {
                      "type": "string",
                      "enum": [
                        "petrol",
                        "diesel",
                        "hybrid",
                        "plug_in_hybrid",
                        "diesel_hybrid",
                        "electric",
                        "lpg"
                      ]
                    },
                    "gearbox": {
                      "type": "string",
                      "enum": [
                        "manual",
                        "automatic"
                      ]
                    },
                    "powerHp": {
                      "type": "integer"
                    },
                    "newPrice": {
                      "type": "integer",
                      "description": "List price when new, in euros"
                    },
                    "standardEquipment": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "optionalEquipment": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "get": {
        "summary": "Search active listings",
        "tags": [
          "search"
        ],
        "description": "All filters are optional and combined with AND. Sold cars are never returned.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "maxLength": 50
            },
            "in": "query",
            "name": "brand",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 50
            },
            "in": "query",
            "name": "model",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "petrol",
                "diesel",
                "hybrid",
                "plug_in_hybrid",
                "diesel_hybrid",
                "electric",
                "lpg"
              ]
            },
            "in": "query",
            "name": "fuel",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "in": "query",
            "name": "priceMin",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "in": "query",
            "name": "priceMax",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1990
            },
            "in": "query",
            "name": "yearMin",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1990
            },
            "in": "query",
            "name": "yearMax",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "price_asc",
                "price_desc",
                "year_desc",
                "mileage_asc"
              ],
              "default": "price_asc"
            },
            "in": "query",
            "name": "sort",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "in": "query",
            "name": "page",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "in": "query",
            "name": "pageSize",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "integer",
                      "description": "Number of matching listings (all pages)"
                    },
                    "page": {
                      "type": "integer"
                    },
                    "pageSize": {
                      "type": "integer"
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "listingId": {
                            "type": "integer"
                          },
                          "brand": {
                            "type": "string"
                          },
                          "model": {
                            "type": "string"
                          },
                          "version": {
                            "type": "string"
                          },
                          "fuel": {
                            "type": "string",
                            "enum": [
                              "petrol",
                              "diesel",
                              "hybrid",
                              "plug_in_hybrid",
                              "diesel_hybrid",
                              "electric",
                              "lpg"
                            ]
                          },
                          "gearbox": {
                            "type": "string",
                            "enum": [
                              "manual",
                              "automatic"
                            ]
                          },
                          "year": {
                            "type": "integer"
                          },
                          "mileageKm": {
                            "type": "integer"
                          },
                          "price": {
                            "type": "integer"
                          },
                          "priceRating": {
                            "type": "string",
                            "enum": [
                              "good_deal",
                              "fair",
                              "high"
                            ],
                            "description": "Price vs the average active price of the same version and year"
                          },
                          "dealerId": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/dealer-sync/status": {
      "get": {
        "summary": "Last stock sync per dealer (depends on an unreliable upstream service)",
        "tags": [
          "dealer-sync"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "dealers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "dealerId": {
                            "type": "string"
                          },
                          "activeListings": {
                            "type": "integer"
                          },
                          "lastSyncAt": {
                            "type": "string",
                            "nullable": true
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/pricing": {
      "get": {
        "summary": "Suggest a price from the exact version, year and mileage",
        "tags": [
          "pricing"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "in": "query",
            "name": "versionId",
            "required": true,
            "description": "Catalogue version (from GET /vehicles/:plate)"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1990,
              "maximum": 2100
            },
            "in": "query",
            "name": "year",
            "required": true,
            "description": "Year of first registration"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2000000
            },
            "in": "query",
            "name": "mileageKm",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "versionId": {
                      "type": "integer"
                    },
                    "year": {
                      "type": "integer"
                    },
                    "mileageKm": {
                      "type": "integer"
                    },
                    "estimatedPrice": {
                      "type": "integer",
                      "description": "Suggested asking price in euros"
                    },
                    "range": {
                      "type": "object",
                      "properties": {
                        "low": {
                          "type": "integer"
                        },
                        "high": {
                          "type": "integer"
                        }
                      }
                    },
                    "basis": {
                      "type": "object",
                      "description": "How the estimate was built",
                      "properties": {
                        "newPrice": {
                          "type": "integer"
                        },
                        "ageYears": {
                          "type": "integer"
                        },
                        "shareKept": {
                          "type": "number",
                          "description": "Share of the new price kept at this age"
                        },
                        "mileageFactor": {
                          "type": "number"
                        },
                        "comparableListings": {
                          "type": "integer",
                          "description": "Active listings with the same version and year"
                        },
                        "marketAverage": {
                          "type": "integer",
                          "description": "Their average price",
                          "nullable": true
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/listings/generate": {
      "post": {
        "summary": "Write a French ad (title + description) for a car",
        "tags": [
          "listings"
        ],
        "description": "The ad is written from the car's facts: its catalogue version, the options selected by the seller, and the year, mileage, price and colour. The facts are returned with the text.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "versionId",
                  "year",
                  "mileageKm",
                  "price"
                ],
                "additionalProperties": false,
                "properties": {
                  "versionId": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "year": {
                    "type": "integer",
                    "minimum": 1990,
                    "maximum": 2100
                  },
                  "mileageKm": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2000000
                  },
                  "price": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "color": {
                    "type": "string",
                    "maxLength": 30
                  },
                  "options": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "string",
                      "maxLength": 40
                    },
                    "description": "Optional equipment the car has (codes from the version's optional equipment)"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "facts": {
                      "type": "object",
                      "properties": {
                        "versionId": {
                          "type": "integer"
                        },
                        "brand": {
                          "type": "string"
                        },
                        "model": {
                          "type": "string"
                        },
                        "version": {
                          "type": "string"
                        },
                        "fuel": {
                          "type": "string"
                        },
                        "gearbox": {
                          "type": "string"
                        },
                        "powerHp": {
                          "type": "integer"
                        },
                        "year": {
                          "type": "integer"
                        },
                        "mileageKm": {
                          "type": "integer"
                        },
                        "price": {
                          "type": "integer"
                        },
                        "color": {
                          "type": "string",
                          "nullable": true
                        },
                        "equipment": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "writer": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "template",
                            "claude"
                          ]
                        },
                        "model": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "details": {}
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "details": {}
                  }
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "details": {}
                  }
                }
              }
            }
          },
          "422": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "details": {}
                  }
                }
              }
            }
          },
          "502": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "details": {}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
