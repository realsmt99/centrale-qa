{
  "name": "centrale-qa",
  "version": "1.0.0",
  "description": "Mini La Centrale (a car marketplace backend with planted bugs) and QA Pilot (an AI-assisted QA pipeline).",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "seed": "tsx data/generate.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --testPathIgnorePatterns bughunt flaky",
    "test:bughunt": "jest bughunt flaky --passWithNoTests",
    "test:all": "jest",
    "openapi": "tsx scripts/export-openapi.ts",
    "qa:design": "tsx qa-pilot/cli/design.ts",
    "qa:issue-design": "tsx qa-pilot/cli/issue-design.ts",
    "qa:issue-review": "tsx qa-pilot/cli/issue-review.ts"
  },
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
